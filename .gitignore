# Solvex Report - .gitignore

# Local configuration (contains secrets)
config.local.php

# Storage
storage/logs/*
storage/uploads/*
!storage/logs/.gitkeep
!storage/uploads/.gitkeep

# PHPMailer vendor (if manually vendored, may want to track)
# vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# PHP
*.cache
